gameOfLife <- function(size, rounds, initial){
     
     # Initialize
     if(is.matrix(initial)){
          grid <- initial
          size <- nrow(initial)
     } else {
          grid <- matrix(sample(c(0, 1), size^2, replace = TRUE), nrow = size)
     }
     
     for(i in 1:rounds){
          heatmap(grid, scale = "none", Rowv = NA, Colv = NA, col = c("white", "magenta2"),
                  labRow="", labCol="", main = paste("Game of life, round ", i))
          
          grid_next <- grid
          for(j in 1:size){
               rows = c(-1, 0, 1)
               if(j == 1){
                    rows = c(0, 1)
               }
               if(j == size){
                    rows = c(-1, 0)
               }
               
               for(k in 1:size){
                    cols = c(-1, 0, 1)
                    if(k == 1){
                         cols = c(0, 1)
                    }
                    if(k == size){
                         cols = c(-1, 0)
                    }
                    
                    neighborhood = grid[j+rows, k+cols] 
                    neighbors_alive = sum(neighborhood) - grid[j, k]
                    
                    if(neighbors_alive < 2 || neighbors_alive > 3){ # Death
                         grid_next[j,k] <- 0
                    } else if(grid[j,k] == 1 && neighbors_alive == 2){ # Stay alive
                         grid_next[j,k] <- 1
                    } else if(neighbors_alive == 3){ # Resurrection
                         grid_next[j,k] <- 1
                    }
               }
          }
          
          grid <- grid_next
          Sys.sleep(0.05)
     }
}


## Inputs
#  size: Integer determining the side length of the square arena,
#  rounds: Integer issuing how long the game is iterated
#  initial: randomized by "random", all cells determined to be alive by "all alive", or a custom matrix of size n*n can be supplied as such 

# Random arena
gameOfLife(
     size = 500,
     rounds = 1000,
     initial = "random"
)


